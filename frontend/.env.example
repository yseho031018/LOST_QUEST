# Optional public API address. Never put passwords, tokens, or private keys in VITE_ variables.
# Copy to .env.local and restart Vite to enable the manual footer connection check.
VITE_API_BASE_URL=http://127.0.0.1:8081

# Optional: 'true' shows the reference-only AI photo similarity area on match cards (off by default).
# VITE_FEATURE_AI_PHOTO_SIMILARITY=true

# Optional: Google OAuth web client id (public, not a secret). Shows the Google sign-in button.
# The backend must use the same id (app.social-login.google.client-id). Open the app at http://localhost:<port>,
# not 127.0.0.1 or a LAN IP: Google only accepts origins registered for the client.
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
